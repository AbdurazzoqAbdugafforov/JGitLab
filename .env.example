# ==============================================================================
# JGitLab — AI Engineering Platform Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="JGitLab"
VERSION="0.2.0"
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# Authentication & Cryptographic Signing Keys (REQUIRED in production)
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET="jgitlab-auth-secret-change-in-production-32chars"
BACKEND_INTERNAL_SIGNING_KEY="jgitlab-internal-session-hmac-signing-key-32chars"
SECRET_KEY="jgitlab-production-super-secret-key-change-in-prod-32chars"

# Fernet 32-byte URL-safe base64 key for encrypting AI Provider keys & tokens at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="cE1xWjRkTEpTYnF1Q2U0d1p5N3Y5SGFuYjJ1OTZtNnY="

# Public application origin (used to build OAuth and GitHub App callback URLs)
AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect (Identity Sign-In Only)
# Scopes requested: openid email profile
# Callback URL: ${AUTH_URL}/api/v1/auth/oauth/google/callback
# ------------------------------------------------------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ------------------------------------------------------------------------------
# GitHub OAuth 2.0 (Identity Sign-In Only — Does NOT grant repository access)
# Scopes requested: read:user user:email
# Callback URL: ${AUTH_URL}/api/v1/auth/oauth/github/callback
# ------------------------------------------------------------------------------
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ------------------------------------------------------------------------------
# GitHub App (User-Controlled Repository Access: All vs Selected Repositories)
# Minimal permissions: metadata:read, contents:write, pull_requests:write, checks:read
# Setup & Callback URL: ${AUTH_URL}/api/v1/github/app/callback
# ------------------------------------------------------------------------------
GITHUB_APP_ID=""
GITHUB_APP_NAME=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
# Paste PEM private key (literal \n newlines supported) or set GITHUB_APP_PRIVATE_KEY_PATH
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_PRIVATE_KEY_PATH=""
GITHUB_APP_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# Database & Infrastructure
# ------------------------------------------------------------------------------
# PostgreSQL with pgvector (production / docker-compose):
# DATABASE_URL="postgresql+asyncpg://jgitlab:jgitlab_secure_password_2026@localhost:5432/jgitlab_db"
# SQLite Async fallback (zero-config local developer mode):
DATABASE_URL="sqlite+aiosqlite:///./jgitlab.db"
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# Sandbox & Agent Execution Limits
# ------------------------------------------------------------------------------
MAX_TASK_STEPS=25
MAX_TASK_TOKENS=150000
TASK_TIMEOUT_SECONDS=600
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT="1024m"

# ------------------------------------------------------------------------------
# Frontend Next.js API Rewrite Target
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000"
