# ==========================================
# JGitLab Environment Configuration
# ==========================================

# Application
PROJECT_NAME="JGitLab"
VERSION="0.1.0"

# Cryptographic Keys (Change in production)
# SECRET_KEY must be a 32+ character random secret
SECRET_KEY="jgitlab-production-super-secret-key-change-in-prod-32chars"
# ENCRYPTION_KEY must be a 32-byte URL-safe base64 string for Fernet
ENCRYPTION_KEY="cE1xWjRkTEpTYnF1Q2U0d1p5N3Y5SGFuYjJ1OTZtNnY="

# Database Connection
# PostgreSQL with pgvector (production / docker-compose):
# DATABASE_URL="postgresql+asyncpg://jgitlab:jgitlab_secure_password_2026@localhost:5432/jgitlab_db"
# SQLite Async fallback (zero-config local developer mode):
DATABASE_URL="sqlite+aiosqlite:///./jgitlab.db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# GitHub OAuth App (Optional - Personal Access Tokens can be entered directly in UI)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/callback/github"

# AI Provider Server Fallback (Optional - user can configure securely in UI Settings)
# OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxx"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL_NAME="gpt-4o"
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Sandbox Limits
MAX_TASK_STEPS=25
MAX_TASK_TOKENS=150000
TASK_TIMEOUT_SECONDS=600
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT="1024m"

# Frontend Configuration
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000"
